# 金鑰（範本是 .env.example）
.env

# 虛擬環境
.venv/

# Python 快取
__pycache__/
*.pyc
*.pyo

# 資料（不入版控）
html_cache/
*.db
*.zip
judgments.db*
# 舊版 backfill_structured.py 產生的備份命名（judgments.bak-*.db），
# 不符合上面的 judgments.db* 規則，補一條避免 290 MB 的檔案被 git add 進來
judgments.bak-*.db
*.xlsx
*.log
.DS_Store
# 外部資料集壓縮檔（例如 CAIL2018，約 1 GB）與匯出的 JSONL 資料集
*.zip
*.jsonl
# 刑事萃取報告附的樣本要進版控
!docs/criminal/*.jsonl
# 本機資料夾：組員傳來的資料庫（data_芸菲/）、開放資料 RAR 與轉出的資料庫（data_opendata/）等
data_*/
# 程式資料夾，不是本機資料
!data_pipeline/

# 除錯用暫存頁面
*_page.html

# 簡報與交付文件（不上傳）
*.pptx
*.pdf

# 暫時用的腳本（不屬於核心功能）
check_html.py
check_html2.py
diagnose.py
add_role_stats_slide.py
update_pptx.py

*.ipynb

finaldata/
# 上線用的模型與檢索索引（由 civil/、retrieval/ 的程式產生，見 docs/資料版本.md）
artifacts/

# 測試 fixture 不受上面 *_page.html 規則影響
!tests/fixtures/*.html

# PR 描述草稿（只給自己貼到 GitHub 用）
pr_body.md

# 逐月爬取的進度狀態檔（本機執行紀錄）
crawl_state_*.json
crawl_state_*.json.tmp
罪名頻率表.csv
