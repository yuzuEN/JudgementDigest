# 複製成 .env，填入自己的 key。.env 不進 Git，不要把 key 貼到任何地方。
# 留空 JD_LLM_PROVIDER 就不用 LLM，追問會用固定題庫。

# gemini、openai 或 fake（測試用，不連線、不花錢）
JD_LLM_PROVIDER=
# 留空用預設模型
JD_LLM_MODEL=
# JD_LLM_PROVIDER=gemini 時填
GEMINI_API_KEY=
# JD_LLM_PROVIDER=openai 時填（JD_LLM_MODEL 留空用 gpt-4.1-mini）
OPENAI_API_KEY=
# 用量上限，留空用預設：每個 IP 每小時 10 次、全站每天 300 次
JD_LLM_PER_IP_HOUR=
JD_LLM_PER_DAY=
